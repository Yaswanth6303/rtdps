# -----------------------------------------------------------------------------
# Template for the local .env file. Copy to .env and edit for your environment:
#     cp .env.example .env
#
# spring-dotenv auto-loads .env at boot; the actual .env is gitignored.
# -----------------------------------------------------------------------------

# ---- Postgres (defaults match docker-compose.yml) ----
POSTGRES_URL=jdbc:postgresql://localhost:5432/rtdps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ---- Kafka ----
# 29092 = EXTERNAL listener exposed to the host by the compose stack.
# Inside the compose network the app service should use kafka:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
