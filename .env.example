# Copy to .env (gitignored) and fill in real values before running in any non-dev environment.

# --- Database -----------------------------------------------------------------
POSTGRES_URL=jdbc:postgresql://localhost:5432/rtdps
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- API auth (HTTP Basic) ----------------------------------------------------
API_USER=admin
API_PASSWORD=changeme

# --- Kafka --------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic replication. Dev (single broker): 1 / 1. Prod (>=3 brokers): 3 / 2.
KAFKA_TOPIC_REPLICAS=1
KAFKA_MIN_INSYNC_REPLICAS=1

# --- Storage ------------------------------------------------------------------
# Single-instance / dev:
STORAGE_TYPE=local
# UPLOAD_DIR=/var/rtdps/uploads
# EXPORT_DIR=/var/rtdps/exports

# Multi-instance / prod — switch to S3. Credentials come from the AWS default
# provider chain: env vars, instance profile, ~/.aws/credentials, etc.
# STORAGE_TYPE=s3
# S3_BUCKET=rtdps-prod
# S3_REGION=us-east-1
# S3_UPLOAD_PREFIX=uploads/
# S3_EXPORT_PREFIX=exports/
# S3_ENDPOINT=                # MinIO/RustFS / LocalStack: http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Server -------------------------------------------------------------------
SERVER_PORT=9191

# --- Multipart upload limits --------------------------------------------------
# Default 50 MB per file and per request. Raise for large CSV ingestion.
# Accepts Spring DataSize syntax: 100MB, 1GB, 500KB.
# UPLOAD_MAX_FILE_SIZE=500MB
# UPLOAD_MAX_REQUEST_SIZE=500MB

# --- Alerting -----------------------------------------------------------------
# Optional. When set, every DLT message also POSTs a JSON alert to this URL.
# Works with Slack incoming webhooks, PagerDuty events API v2, or any custom endpoint.
# ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# --- Stuck-tracker sweeper ----------------------------------------------------
# Periodic reconciliation of trackers stuck in QUEUED/PROCESSING. Defaults are
# sane for prod (1 min scan, 15 min forgiveness for long-running jobs).
# SWEEPER_ENABLED=true
# SWEEPER_INTERVAL_MS=60000
# SWEEPER_INITIAL_DELAY_MS=30000
# SWEEPER_STUCK_THRESHOLD_MIN=15
