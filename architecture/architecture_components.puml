@startuml architecture_components
title RTDPS — Layered Component Architecture

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam component {
    BackgroundColor #E8F0FE
    BorderColor #3F6FB2
    FontColor #1F2D3D
}
skinparam database {
    BackgroundColor #FFF4E6
    BorderColor #C97A1F
    FontColor #1F2D3D
}
skinparam queue {
    BackgroundColor #FCE8E8
    BorderColor #B14A4A
    FontColor #1F2D3D
}
skinparam package {
    BackgroundColor #F7F9FC
    BorderColor #888888
    FontColor #1F2D3D
    FontStyle bold
}
skinparam ArrowColor #444444
skinparam ArrowFontColor #444444

actor "Client\n(REST / Swagger UI)" as Client

package "HTTP Ingress Plane" {
    [JobController\n<<@RestController>>] as Ctrl
}

package "Kafka Orchestration Plane" {
    [JobRequest\nProducer] as JRP
    queue "job-requests\n(3 partitions)" as TR
    [JobRequest\nConsumer] as JRC
    [JobCompletion\nListener] as JCL
    [JobEvent\nProducer] as JEP
    queue "job-events\n(3 partitions)" as TE
    [JobEvent\nConsumer] as JEC
    queue "job-requests.DLT" as DLT
    [DefaultError\nHandler\n(retry 3x, 1s backoff)] as ERR
}

package "Spring Batch Execution Plane" {
    [BatchJobService] as BJS

    package "Import Step (multi-threaded)" {
        [FlatFileItemReader\n+ Synchronized\nItemStreamReader] as RD
        [CustomerProcessor\n(trim, validate)] as PR
        [JdbcBatchItemWriter\nON CONFLICT DO NOTHING] as WR
        [ThreadPoolTaskExecutor\ncore=10  max=20] as TPE
    }

    package "Export Step" {
        [JdbcCursorItemReader] as ERD
        [FlatFileItemWriter] as EWR
    }
}

package "Persistence Layer" {
    database "customers" as DB1
    database "job_tracker" as DB2
    database "Spring Batch\nmetadata" as DB3
    [uploads/ , exports/\n(filesystem)] as FS
}

' --- Ingress flow
Client --> Ctrl : POST /jobs/importCustomers\nPOST /jobs/exportCustomers\nGET  /jobs/status/{id}\nGET  /jobs/download/{id}
Ctrl --> FS    : save uploaded CSV
Ctrl --> DB2   : save JobTracker (QUEUED)
Ctrl --> JRP   : sendJobRequest

' --- Kafka request path
JRP --> TR
TR  --> JRC
ERR ..> DLT   : poison message

' --- Job dispatch
JRC --> DB2   : update PROCESSING
JRC --> BJS   : launch job

' --- Import step
BJS --> RD
RD  --> PR
PR  --> WR
WR  --> DB1
TPE .right.> RD : drives chunks

' --- Export step
BJS --> ERD
ERD --> EWR
EWR --> FS

' --- Completion and event emission
BJS ..> JCL   : afterJob
JCL --> DB2   : update COMPLETED\nstore counts + duration
JCL --> JEP   : publishJobEvent
JEP --> TE
TE  --> JEC

' --- Spring Batch internal metadata
BJS ..> DB3

@enduml
